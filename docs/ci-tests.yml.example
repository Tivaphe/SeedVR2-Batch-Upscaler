name: CPU tests
on:
  push:
  pull_request:
permissions:
  contents: read
jobs:
  tests:
    strategy:
      matrix:
        os: [ubuntu-latest, windows-latest]
        python: ['3.11', '3.12']
    runs-on: ${{ matrix.os }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python }}
      - run: python -m pip install Pillow numpy "gradio>=5,<6"
      - run: python tests/selftest.py
      - run: python -m unittest discover -s tests -p "test_*.py" -v
      - run: python -m compileall -q app.py seedvr2_upscaler scripts
